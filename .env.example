# Сторонний OpenAI-совместимый провайдер: один ключ на chat и embeddings.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Бюджет токенов на реплику; у reasoning-моделей включает рассуждения.
MAX_TOKENS=1000
# Суммаризация сессии в запись памяти: точность вместо разнообразия,
# бюджет с запасом на рассуждения.
SUMMARIZER_TEMPERATURE=0.0
SUMMARIZER_MAX_TOKENS=2000

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Персона новой сессии, если клиент не указал её явно (имя директории в persona/).
# Не задана — первая по алфавиту.
# DEFAULT_PERSONA=

# N переинжекта по умолчанию — подбирается замером eval/;
# персона может переопределить его в persona/<name>/persona.toml
REINJECT_EVERY=6
SESSION_WINDOW=20
# Сколько дней живут история сессии и колода первых реплик в Redis.
SESSION_TTL_DAYS=30

# Ограничения входа API.
API_USER_ID_MAX_CHARS=128
API_SESSION_ID_MAX_CHARS=128
API_PERSONA_MAX_CHARS=64
API_MESSAGE_MAX_CHARS=4000

# Меньше стольких сообщений — сессию нечего сжимать в запись памяти.
ARCHIVE_MIN_MESSAGES=2
# Длина отпечатка набора первых реплик в ключе колоды.
DECK_FINGERPRINT_CHARS=16
# Сколько символов ответа модели показывать в логах и отчётах замера.
LOG_PREVIEW_CHARS=200

# Окна замера дрейфа: EVAL_WINDOWS окон по EVAL_WINDOW реплик.
EVAL_WINDOW=8
EVAL_WINDOWS=3
